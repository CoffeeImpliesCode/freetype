// SPDX-License-Identifier: MIT
.{
    // Package, module, and artifact name.
    .name = .freetype,
    .fingerprint = 0xac2059b6dfa9d2f2,
    // Upstream release, checked against the vendored headers by build.zig.
    .version = "2.14.3",
    .minimum_zig_version = "0.16.0",
    // No external Zig dependencies.
    .dependencies = .{},
    .paths = .{
        "build.zig",
        "build.zig.zon",
        // cross-test settings profile.
        "cross-test.profile.sh",
        // Facade and runtime imports used by dependent modules.
        "zig",
        // Upstream source, headers, tests, manuals, and build files.
        "include",
        "src",
        "builds",
        "docs",
        "tests",
        "modules.cfg",
        "LICENSE.TXT",
        "README",
        "README.git",
        "ChangeLog",
        "CMakeLists.txt",
        "Makefile",
        "meson.build",
        "meson_options.txt",
        "configure",
        "autogen.sh",
        "vms_make.com",
        "MSBuild.rsp",
        "MSBuild.sln",
        ".clang-format",
        "tests.zig",
        "smoke.zig",
        // Standalone consumer package.
        "consumer/build.zig",
        "consumer/build.zig.zon",
        "consumer/src/main.zig",
        // Source-provenance checker.
        "tools",
        // Runtime loader and generated dispatch.
        "runtime",
        // Nix derivation, flake, and development-shell files.
        "package.nix",
        "flake.nix",
        "devenv.nix",
        "devenv.yaml",
        ".envrc",
        // Exclude build outputs and local state.
        "UPSTREAM.md",
        "UPSTREAM.sha256",
        "README.md",
        "README.zig.md",
        "NOTICE.md",
        "CHANGELOG.md",
        "FORK-NOTES.md",
        "FORK-LICENSE.md",
        ".gitignore",
    },
}
